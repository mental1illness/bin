--# Aliases

local GetService = Game.GetService

--# Services

local HttpService = GetService(Game, "HttpService")

--# Variables

local GameData = HttpService:JSONDecode(
    Game:HttpGet("https://cats-cure-depression.vercel.app/moehack.net/data/supported_game.json")
)[tostring(Game.PlaceId)] or {
    game_name = "Universal",
    run_on_actor = false,
    use_custom_silent_aim = false,
    tab_to_remove = {},
}

local Commit = HttpService:JSONDecode(request({
	Url = "https://api.github.com/repos/mental1illness/bin/commits?per_page=1",
	Method = "GET",
}).Body)[1]

--# Main



getgenv().moehack = {
    data = GameData,
    current_sha = Commit.sha
}

if GameData["run_on_actor"] then 
    local RunFunc = run_on_thread or run_on_actor
    local Actors  = getactorthreads or getactors

    local Code = [[
        local GetService = Game.GetService
        local HttpService = GetService(Game, "HttpService")

        local GameData = HttpService:JSONDecode(
            Game:HttpGet("https://cats-cure-depression.vercel.app/moehack.net/data/supported_game.json")
        )[tostring(Game.PlaceId)] or {
            game_name = "Universal",
            run_on_actor = false,
            use_custom_silent_aim = false,
            tab_to_remove = {},
        }
            
        local Commit = HttpService:JSONDecode(request({
            Url = "https://api.github.com/repos/mental1illness/bin/commits?per_page=1",
            Method = "GET",
        }).Body)[1]

        getgenv().moehack = {
            data = GameData,
            current_sha = Commit.sha
        }
    ]] .. Game:HttpGet(
        "https://cats-cure-depression.vercel.app/moehack.net/cheat.luau"
    )
    local Actor = Actors()[1]
    if Actor then
        RunFunc(Actor, Code)
    else
        loadstring(Game:HttpGet("https://cats-cure-depression.vercel.app/moehack.net/cheat.luau"))()
    end
    
    return 
end

loadstring(Game:HttpGet("https://cats-cure-depression.vercel.app/moehack.net/cheat.luau"))()